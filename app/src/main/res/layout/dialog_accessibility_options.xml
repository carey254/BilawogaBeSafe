<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/background"
    android:padding="16dp"
    android:maxHeight="400dp">

    <!-- Header Section with Cancel Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp"
        android:padding="12dp"
        android:background="@drawable/background"
        android:elevation="4dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_accessibility"
            android:tint="#1976D2"
            android:layout_marginEnd="12dp"
            android:contentDescription="Accessibility Icon" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Accessibility Options"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1976D2" />

        <Button
            android:id="@+id/btnCancelAccessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textSize="18sp"
            android:textColor="#D32F2F"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="8dp"
            android:contentDescription="Close Accessibility Options" />

    </LinearLayout>

        <!-- Audio Settings Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FF7A1A"
            app:strokeColor="#CC5E10"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Row: Read Page -->
                <LinearLayout
                    android:id="@+id/rowReadPage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        android:tint="#FFFFFFFF"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Read Page"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFFFFF33" />

                <!-- Row: Auto Read switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_lock_silent_mode_off"
                        android:tint="#FFFFFFFF"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Auto Read"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />
                    <Switch
                        android:id="@+id/switchAutoRead"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="#FFFFFFFF"
                        android:trackTint="#FFFFFF55" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFFFFF33" />

                <!-- Row: Cursor Reading switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_compass"
                        android:tint="#FFFFFFFF"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cursor Reading"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />
                    <Switch
                        android:id="@+id/switchCursorReading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="#FFFFFFFF"
                        android:trackTint="#FFFFFF55" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFFFFF33" />

                <!-- Visual Accessibility Card -->
                <!-- Row: Text Larger -->
                <LinearLayout
                    android:id="@+id/btnTextLarger"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_input_add"
                        android:tint="#FFFFFFFF"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Text Larger"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFFFFF33" />

                <!-- Row: Text Smaller -->
                <LinearLayout
                    android:id="@+id/btnTextSmaller"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?attr/selectableItemBackground"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_delete"
                        android:tint="#FFFFFFFF"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Text Smaller"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFFFFF33" />

                <!-- Row: Contrast value -->
                <LinearLayout
                    android:id="@+id/rowContrast"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_view"
                        android:tint="#FFFFFFFF"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Contrast"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/textContrastValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        android:textColor="#FFEBD6"
                        android:textSize="14sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFFFFF33" />

                <!-- Row: Colors value -->
                <LinearLayout
                    android:id="@+id/rowColors"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_manage"
                        android:tint="#FFFFFFFF"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Colors"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/textColorsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Normal"
                        android:textColor="#FFEBD6"
                        android:textSize="14sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFFFFF33" />

                <!-- Row: Language selector -->
                <LinearLayout
                    android:id="@+id/rowLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:background="?attr/selectableItemBackground">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@android:drawable/ic_menu_sort_alphabetically"
                        android:tint="#FFFFFFFF"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Language"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/textLanguageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="English"
                        android:textColor="#FFEBD6"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Reset Settings Card -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="Reset All"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D84343"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/ic_menu_revert"
                    app:iconTint="@android:color/white" />
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStopReading"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="Stop Reading"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#616161"
                    app:cornerRadius="8dp"
                    app:icon="@android:drawable/ic_media_pause"
                    app:iconTint="@android:color/white" />
                
                <TextView
                    android:id="@+id/textFooterStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Font: 100% | Normal | Auto: OFF"
                    android:textColor="#FFEBD6"
                    android:textSize="12sp"
                    android:gravity="center" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

