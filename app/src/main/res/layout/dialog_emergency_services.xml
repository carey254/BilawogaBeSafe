<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@android:color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/emergency_help_center_kenya"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:textColor="#D32F2F"/>

    <!-- Kenya Police -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/kenya_police"
            android:textSize="16sp"
            android:textColor="#212121"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/police_numbers"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:onClick="onEmergencyCall"
            android:tag="tel:999"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/police_description"
        android:textSize="12sp"
        android:textColor="#616161"
        android:layout_marginBottom="8dp"/>

    <!-- Ambulance: St John / Red Cross -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ambulance_st_john"
            android:textSize="16sp"
            android:textColor="#212121"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ambulance_number"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:onClick="onEmergencyCall"
            android:tag="tel:1199"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ambulance_description"
        android:textSize="12sp"
        android:textColor="#616161"
        android:layout_marginBottom="8dp"/>

    <!-- Gender-Based Violence (GBV) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gbv_helpline"
            android:textSize="16sp"
            android:textColor="#212121"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/gbv_number"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:onClick="onEmergencyCall"
            android:tag="tel:1195"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gbv_description"
        android:textSize="12sp"
        android:textColor="#616161"
        android:layout_marginBottom="8dp"/>

    <!-- Child Helpline -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/child_helpline"
            android:textSize="16sp"
            android:textColor="#212121"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/child_helpline_number"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:onClick="onEmergencyCall"
            android:tag="tel:116"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/child_helpline_description"
        android:textSize="12sp"
        android:textColor="#616161"
        android:layout_marginBottom="8dp"/>

    <!-- Health Hotline (Ministry of Health) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/health_hotline"
            android:textSize="16sp"
            android:textColor="#212121"/>

        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/health_hotline_number"
            android:textColor="#FFFFFF"
            android:backgroundTint="#D32F2F"
            android:onClick="onEmergencyCall"
            android:tag="tel:719"/>
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/health_hotline_description"
        android:textSize="12sp"
        android:textColor="#616161"
        android:layout_marginBottom="8dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/mental_health_tip"
        android:textSize="12sp"
        android:textColor="#757575"
        android:gravity="center"
        android:lineSpacingExtra="4dp"/>

</LinearLayout>
